{
    "name": "gallib/pssg",
    "description": "PHP Static Site Generator",
    "type": "library",
    "require": {
        "php": "^8.5",
        "symfony/process": "^8.1",
        "league/commonmark": "^2.10",
        "symfony/yaml": "^8.1",
        "symfony/console": "^8.1"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Gallib\\PSSG\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Alain Pellaux",
            "email": "alain@gallib.net"
        }
    ],
    "minimum-stability": "stable",
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.95",
        "squizlabs/php_codesniffer": "^4.0",
        "pestphp/pest": "^5.2"
    },
    "bin": [
        "bin/pssg"
    ],
    "scripts": {
        "cs:fix": "php-cs-fixer fix",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "sniff:fix": "phpcbf -ps",
        "sniff:check": "phpcs -ps",
        "stan": "phpstan analyse",
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "archive": {
        "exclude": [
            "/vendor",
            "/tests",
            "/docker",
            "/Dockerfile",
            "/docker-compose.yml",
            "/docker-compose.override.yml",
            "/Makefile",
            "/phpstan.neon",
            "/phpcs.xml",
            "/phpunit.xml",
            "/.php-cs-fixer.php",
            "/.php-cs-fixer.cache",
            "/.DS_Store"
        ]
    }
}
